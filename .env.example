# Absolute public origin, no trailing slash. Drives metadataBase, canonical
# URLs, the sitemap, llms.txt and the @duck registry URL shown in the docs.
# Changing this is the only step needed to move the site to another domain.
NEXT_PUBLIC_SITE_URL=https://duckui.davideghiotto.it

# Dokploy deploy token. Never commit the real value — set it in the Dokploy
# project environment, not in this file.
DOKPLOY_API_KEY=
