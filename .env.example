# Absolute public origin, no trailing slash. Drives metadataBase, canonical
# URLs, the sitemap, llms.txt and the @duck registry URL shown in the docs.
# Changing this is the only step needed to move the site to another domain.
NEXT_PUBLIC_SITE_URL=https://duckui.davideghiotto.it

# Self-hosted Umami. Both are read at build time. Leave them empty and no
# script is served, the legal pages state that no analytics runs, and both
# statements stay true — the privacy and cookie notices branch on exactly these
# variables, so configuring analytics without rebuilding is not possible.
#   NEXT_PUBLIC_UMAMI_URL         full URL of script.js on your Umami instance
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID  website id from the Umami dashboard
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Dokploy deploy token. Never commit the real value — set it in the Dokploy
# project environment, not in this file.
DOKPLOY_API_KEY=
